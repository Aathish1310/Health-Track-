{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Antiforgery": "Error"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataPath": ""
  },
  "Security": {
    "EncryptDataAtRest": true,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 10,
    "SessionMinutes": 30
  },
  "Reminders": {
    "ScanIntervalMinutes": 5,
    "AppointmentLeadHours": 24
  },
  "Seed": {
    "CreateDemoData": true
  }
}